# The rules of the static analyzers read on the swim module by the job "analyze" of the build (Microsoft.CodeAnalysis.NetAnalyzers
# and SonarAnalyzer.CSharp): only the ones that find real errors (a value used where it can be null, a result thrown away, a
# picture or a file never released, a number formatted for the wrong reader...). Everything else of the analyzers is off.
is_global = true
global_level = 100

dotnet_analyzer_diagnostic.severity = none

dotnet_diagnostic.CA1001.severity = warning
dotnet_diagnostic.CA1065.severity = warning
dotnet_diagnostic.CA1806.severity = warning
